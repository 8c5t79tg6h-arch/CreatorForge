# AI provider: mock | openai
# On Vercel: Project → Settings → Environment Variables
# Start with mock so the site works with zero secrets.
# Set openai + OPENAI_API_KEY to use the real AI generation engine.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai
# On Vercel: set for Production (and Preview if you test OpenAI there)
# Never prefix with NEXT_PUBLIC_ — keys must stay server-only.
OPENAI_API_KEY=

# Optional OpenAI settings
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# Billing (local Pro Creator activation works without Stripe)
# Future: set Stripe keys to replace local upgrade with Checkout
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_PRO_CREATOR=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
